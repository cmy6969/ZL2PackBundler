<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.3.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- 图标处理：解码常见图片格式 + 缩放 + WebP/PNG 编码 -->
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ZL2PackBundler.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Apk\Installer\BundledPackInstaller.java" />
    <EmbeddedResource Include="Apk\Installer\BundledPackInstaller.dex" />
    <!-- 便携运行时：由 scripts/build-bundled-runtime.ps1 生成；不存在时回退系统 JDK/SDK -->
    <EmbeddedResource Include="Bundled\runtime.zip" Condition="Exists('Bundled\runtime.zip')" />
  </ItemGroup>

</Project>
